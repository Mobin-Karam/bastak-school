# Bastak School — copy these values into Coolify's environment-variable dashboard.
# Do not commit real production domains, API tokens, passwords, or database files.
CORS_ORIGINS=https://stud.sultano.ir,https://app.sultano.ir
COOKIE_SAMESITE=lax
# Keep this at 1. Set to 0 only for a private HTTP-only LAN smoke test.
COOKIE_SECURE=1
# Leave empty for host-only api.sultano.ir access/refresh cookies.
COOKIE_DOMAIN=
TRUST_PROXY_CIDRS=loopback,linklocal,uniquelocal
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SQLITE_BUSY_TIMEOUT_MS=5000
