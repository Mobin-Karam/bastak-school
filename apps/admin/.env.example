VITE_API_URL=/api/v2
# Optional overrides for the dev backend switcher (origins without /api/v2 suffix).
# VITE_* vars are read by the browser bundle; MOSHAVER_* vars are read by the Vite dev proxy.
# VITE_LOCAL_API_ORIGIN=http://localhost:4000
# MOSHAVER_LOCAL_API_ORIGIN=http://localhost:4000
# VITE_REMOTE_API_ORIGIN=https://api.mahakaram.ir
# MOSHAVER_REMOTE_API_ORIGIN=https://api.mahakaram.ir
