{
  "name": "moshaver-admin-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0 --port 8081 --strictPort",
    "build": "tsc -b && vite build --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0 --port 8081 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run src/a11y",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "audit:parity": "node --test scripts/mounted-controllers.node.mjs && node scripts/audit-parity.mjs",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@formkit/drag-and-drop": "^0.2.6",
    "@hookform/resolvers": "^3.9.1",
    "@moshaver/admin-workspace-ui": "file:../../packages/admin-workspace-ui",
    "@moshaver/api-contract": "file:../../packages/api-contract",
    "@persian-tools/persian-tools": "^4.0.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "^7.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
