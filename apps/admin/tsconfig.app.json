{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": ["src"],
  "exclude": [
    "src/features/registration/pages/RegistrationDashboardPage.tsx",
    "src/features/registration/pages/RegistrationPage.tsx",
    "src/features/registration/RegistrationDashboardPage.tsx",
    "src/features/registration/api/**",
    "src/features/registration/registration.context.tsx",
    "src/features/registration/registration.hooks.ts",
    "src/features/registration/registration.provider.tsx",
    "src/features/registration/registration.stories.tsx",
    "src/features/registration/registration.test.tsx",
    "src/features/registration/sections/**"
  ]
}
