NODE_ENV=development
PORT=4000
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/moshaver-v2.sqlite
DATABASE_URL=
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,tauri://localhost,http://tauri.localhost,https://tauri.localhost
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
# Omit for host-only API cookies. Set only after an explicit shared-cookie review.
COOKIE_DOMAIN=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=moshaver_v2_refresh
SQLITE_BUSY_TIMEOUT_MS=5000
LOGIN_ATTEMPT_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MS=900000
SIGNUP_WINDOW_MS=3600000
SIGNUP_MAX_ATTEMPTS=5
MAX_RESTORE_BODY=67108864
TRUST_PROXY=0
# Used only when TRUST_PROXY=1. Comma-separated Fastify/proxy-addr ranges or CIDRs.
TRUST_PROXY_CIDRS=loopback,linklocal,uniquelocal

# SMS.ir API credentials are configured in the privileged Admin UI, never here.
# Deploy this server-only encryption secret through your secret manager (not source control).
SMS_CONFIG_ENCRYPTION_KEY=
SMSIR_MAX_BATCH_SIZE=100

# One-time private organization bootstrap. Never commit real values.
ALLOW_PRODUCTION_BOOTSTRAP=false
PRIVATE_ORGANIZATION_NAME=سازمان خصوصی مه‌کارام
PRIVATE_ORG_PLATFORM_ADMIN_PASSWORD=
PRIVATE_ORG_ORGANIZATION_ADMIN_PASSWORD=
MOBINKARAM_PASSWORD=
PRIVATE_ORG_TEACHER_PASSWORD=
PRIVATE_ORG_MENTOR_PASSWORD=
PRIVATE_ORG_CONTENT_MANAGER_PASSWORD=
PRIVATE_ORG_GUARDIAN_PASSWORD=
MAHAKARAM_PASSWORD=
MAHAKARAM_NATIONAL_CODE=
