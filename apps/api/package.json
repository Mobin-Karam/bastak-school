{
  "name": "moshaver-backend-v2",
  "version": "2.0.0",
  "private": true,
  "description": "NestJS + Fastify + TypeORM backend foundation for Moshaver v2",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch --path tsconfig.dev.json",
    "lint": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "audit:database": "ts-node scripts/audit-database.ts --upgraded",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "migrate:v1": "node scripts/migrate-v1-to-v2.mjs",
    "seed": "npm run build && node dist/database/seeds/school-seed.js",
    "seed:e2e": "npm run build && node dist/database/seeds/security-matrix.js",
    "seed:roles": "npm run build && NODE_ENV=development ALLOW_E2E_SEED=true node dist/database/seeds/security-matrix.js",
    "seed:demo": "npm run build && NODE_ENV=development ALLOW_DEMO_SEED=true node dist/database/seeds/product-demo.js",
    "seed:full": "npm run seed:demo",
    "seed:reset-demo": "npm run build && NODE_ENV=development ALLOW_DEMO_RESET=true node dist/database/seeds/reset-product-demo.js && NODE_ENV=development ALLOW_DEMO_SEED=true node dist/database/seeds/product-demo.js",
    "seed:reset-platform": "npm run build && NODE_ENV=development ALLOW_PLATFORM_RESET=true node dist/database/seeds/reset-platform.js && NODE_ENV=development ALLOW_PLATFORM_SEED=true node dist/database/seeds/product-demo.js",
    "seed:school": "npm run build && NODE_ENV=development ALLOW_E2E_SEED=true node dist/database/seeds/school-seed.js",
    "seed:private-org:dev": "npm run build && NODE_ENV=development node dist/database/seeds/private-organization.js",
    "seed:private-org:production": "npm run build && NODE_ENV=production node dist/database/seeds/private-organization.js",
    "test:e2e:security": "node scripts/security-matrix-e2e.mjs",
    "test:e2e:student": "node scripts/student-journey-e2e.mjs",
    "test:e2e:onboarding": "node scripts/onboarding-journey-e2e.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.2",
    "@fastify/static": "^10.1.3",
    "@moshaver/api-contract": "file:../../packages/api-contract",
    "@moshaver/cmb-activity": "file:../../packages/cmb/activity",
    "@moshaver/cmb-auth": "file:../../packages/cmb/auth",
    "@moshaver/cmb-authorization": "file:../../packages/cmb/authorization",
    "@moshaver/cmb-data-transfer": "file:../../packages/cmb/data-transfer",
    "@moshaver/cmb-health": "file:../../packages/cmb/health",
    "@moshaver/cmb-identity": "file:../../packages/cmb/identity",
    "@moshaver/cmb-infrastructure": "file:../../packages/cmb/infrastructure",
    "@moshaver/cmb-kernel": "file:../../packages/cmb/kernel",
    "@moshaver/cmb-notifications": "file:../../packages/cmb/notifications",
    "@moshaver/cmb-persistence": "file:../../packages/cmb/persistence",
    "@moshaver/cmb-realtime": "file:../../packages/cmb/realtime",
    "@moshaver/cmb-system": "file:../../packages/cmb/system",
    "@moshaver/cmb-tenancy": "file:../../packages/cmb/tenancy",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "5.12.5",
    "multer": "2.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sms-typescript": "^2.0.3",
    "typeorm": "^0.3.20",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^12.1.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "fastify": "5.12.5",
    "multer": "2.4.0",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    },
    "fast-uri@>=4 <5": "4.2.2"
  },
  "engines": {
    "node": ">=22.5.0 <23"
  }
}
