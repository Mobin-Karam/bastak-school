# Exact browser origins for the one shared Admin Vite build. Keep API clients
# independent: CORS governs browser response headers, not API authorization.
CORS_ORIGINS=https://app.sultano.ir,https://stud.sultano.ir
COOKIE_SECURE=1
COOKIE_SAMESITE=lax

# Generate a VAPID pair once in a secure operator environment (for example,
# `npx web-push generate-vapid-keys`), then paste the values only into the
# protected production.env. The subject must be a monitored mailto: URI.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
