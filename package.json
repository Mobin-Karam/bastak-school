{
  "name": "moshaver-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Repository orchestration manifest for the Moshaver v2 monorepo.",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "workspace:list": "node tooling/workspace/run.mjs list",
    "workspace:check": "node tooling/workspace/check.mjs",
    "workspace:plan": "node tooling/workspace/run.mjs plan",
    "architecture:check": "node tooling/architecture/check-boundaries.mjs && node tooling/architecture/check-cmb-packages.mjs",
    "architecture:self-test": "node tooling/architecture/check-cmb-packages.mjs --self-test",
    "cmb:compatibility": "node tooling/cmb/check-compatibility.mjs",
    "cmb:publish:check": "node tooling/cmb/prepare-publish.mjs --check",
    "cmb:pack": "node tooling/cmb/prepare-publish.mjs --pack",
    "test:cmb-publish": "node --test tooling/cmb/prepare-publish.test.mjs",
    "generate:cmb": "node tooling/generators/create-cmb-package.mjs",
    "generate:cmb-app": "node tooling/generators/create-cmb-app.mjs",
    "test:generators": "node --test tooling/generators/*.test.mjs",
    "generate:product": "node tooling/generators/create-product-package.mjs",
    "verify:affected": "node tooling/workspace/run.mjs verify --affected",
    "contracts:check": "node tooling/contracts/check-api-contract.mjs",
    "docs:check": "node tooling/docs/check-docs.mjs",
    "graphify:check": "node tooling/graphify/fingerprint.mjs --check=graphify-out/code-fingerprint.json",
    "graphify:generate": "graphify update . && node tooling/graphify/fingerprint.mjs --write=graphify-out/code-fingerprint.json",
    "preflight:release": "./scripts/cicd/pre-commit-release-check.sh",
    "bootstrap": "node tooling/workspace/run.mjs bootstrap",
    "build": "node tooling/workspace/run.mjs run build",
    "test": "node tooling/workspace/run.mjs run test",
    "test:all": "npm run verify && npm run test:generators && npm run test:cmb-publish && npm --prefix apps/admin run test:coverage && ./scripts/deploy/verify-security.sh && npm --prefix apps/admin run test:e2e -- --grep 'desktop panels remain reachable' && python3 -m unittest discover -s tooling/cicd -p 'test_*.py'",
    "typecheck": "node tooling/workspace/run.mjs run typecheck",
    "lint": "node tooling/workspace/run.mjs run lint",
    "verify": "node tooling/workspace/run.mjs verify"
  },
  "moshaver": {
    "workspaceGraph": "tooling/workspace/projects.json",
    "installModel": "leaf-lockfiles"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  }
}
